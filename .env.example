# Lumis Falcon Trainer — environment configuration
# Copy to `.env` and fill in once your Supabase project exists.
# With these unset, the app runs in offline guest mode (studying works,
# cloud sync/auth are inactive).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Lumis Smart Score submission endpoint
VITE_SMART_SCORE_URL=

# Optional: interim private-beta access code. When set, users must enter this
# code before reaching the app. This is a SOFT gate (bundled client-side) —
# real per-pilot security comes from Supabase Auth. Leave blank for open access
# or rely on Vercel/Netlify password protection instead.
VITE_ACCESS_CODE=

