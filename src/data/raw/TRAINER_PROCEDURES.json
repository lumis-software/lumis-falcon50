[
  {
    "id": "preflight",
    "category": "Normal",
    "name": "Pre-Flight Setup",
    "desc": "Cold and dark to ready for engine start. Battery on, fire test, fuel check, FMS setup.",
    "steps": [
      {
        "ctrl": "bat1",
        "target": "ON",
        "action": "Battery 1 — ON",
        "note": "Powers L Main DC bus via battery feed"
      },
      {
        "ctrl": "bat2",
        "target": "ON",
        "action": "Battery 2 — ON",
        "note": "Powers R Main DC bus"
      },
      {
        "ctrl": "navLt",
        "target": "ON",
        "action": "NAV lights — ON",
        "note": "Position lights (red left, green right, white tail)"
      },
      {
        "ctrl": "parkBrk",
        "target": "SET",
        "action": "Parking Brake — SET",
        "note": "Sys 2 accumulator pressure required"
      },
      {
        "ctrl": "boost1",
        "target": "ON",
        "action": "BOOST 1 — ON",
        "note": "Required before engine start"
      },
      {
        "ctrl": "boost2",
        "target": "ON",
        "action": "BOOST 2 — ON"
      },
      {
        "ctrl": "boost3",
        "target": "ON",
        "action": "BOOST 3 — ON"
      }
    ]
  },
  {
    "id": "before_start",
    "category": "Normal",
    "name": "APU Start + Before Engine Start",
    "desc": "APU to RUN for bleed and ground power. Beacon on, clearance set, ready for engine start.",
    "steps": [
      {
        "ctrl": "apuMaster",
        "target": "START",
        "action": "APU MASTER — START",
        "note": "APU spins up, ITT rises"
      },
      {
        "ctrl": "apuMaster",
        "target": "RUN",
        "action": "APU MASTER — RUN",
        "note": "After APU stabilizes at 100% N1"
      },
      {
        "ctrl": "apuGen",
        "target": "ON",
        "action": "APU GEN — ON",
        "note": "Powers both Main DC buses (300A)"
      },
      {
        "ctrl": "apuBleed",
        "target": "ON",
        "action": "APU BLEED — ON",
        "note": "Provides bleed air for engine start"
      },
      {
        "ctrl": "beacon",
        "target": "ON",
        "action": "BEACON — ON",
        "note": "Required before engine start"
      }
    ]
  },
  {
    "id": "engine_start",
    "category": "Normal",
    "name": "Engine Start (ENG 2 first)",
    "desc": "Start sequence: ENG 2 (S-duct) first using APU bleed, then ENG 1, then ENG 3. Monitor ITT.",
    "steps": [
      {
        "ctrl": "start2",
        "target": "GND START",
        "action": "Start Selector 2 — GND START"
      },
      {
        "ctrl": "startPB2",
        "target": "PRESS",
        "action": "Start Pushbutton 2 — PRESS (<2 sec)",
        "note": "ITT must rise within 10 sec"
      },
      {
        "ctrl": "power2",
        "target": "IDLE",
        "action": "ENG 2 Power Lever — IDLE",
        "note": "When N2 reaches ~20% and N1 turning"
      },
      {
        "ctrl": "gen2",
        "target": "ON",
        "action": "GEN 2 — ON",
        "note": "After N2 stabilizes"
      },
      {
        "ctrl": "start1",
        "target": "GND START",
        "action": "Start Selector 1 — GND START"
      },
      {
        "ctrl": "startPB1",
        "target": "PRESS",
        "action": "Start Pushbutton 1 — PRESS"
      },
      {
        "ctrl": "power1",
        "target": "IDLE",
        "action": "ENG 1 Power Lever — IDLE"
      },
      {
        "ctrl": "gen1",
        "target": "ON",
        "action": "GEN 1 — ON"
      },
      {
        "ctrl": "start3",
        "target": "GND START",
        "action": "Start Selector 3 — GND START"
      },
      {
        "ctrl": "startPB3",
        "target": "PRESS",
        "action": "Start Pushbutton 3 — PRESS"
      },
      {
        "ctrl": "power3",
        "target": "IDLE",
        "action": "ENG 3 Power Lever — IDLE"
      },
      {
        "ctrl": "gen3",
        "target": "ON",
        "action": "GEN 3 — ON"
      }
    ]
  },
  {
    "id": "before_taxi",
    "category": "Normal",
    "name": "Before Taxi",
    "desc": "All engines online — transfer to engine bleed, secure APU, configure for takeoff.",
    "steps": [
      {
        "ctrl": "bleedCabin",
        "target": "ON",
        "action": "CABIN BLEED — ON",
        "note": "Switch to engine bleed"
      },
      {
        "ctrl": "bleedCrew",
        "target": "ON",
        "action": "CREW BLEED — ON"
      },
      {
        "ctrl": "bleedPRV",
        "target": "AUTO",
        "action": "PRV — AUTO",
        "note": "Auto-opens for ECU capacity"
      },
      {
        "ctrl": "apuBleed",
        "target": "OFF",
        "action": "APU BLEED — OFF"
      },
      {
        "ctrl": "apuGen",
        "target": "OFF",
        "action": "APU GEN — OFF"
      },
      {
        "ctrl": "apuMaster",
        "target": "OFF",
        "action": "APU MASTER — OFF",
        "note": "APU shutdown"
      },
      {
        "ctrl": "pitotHt",
        "target": "ON",
        "action": "PITOT HEAT — ON"
      },
      {
        "ctrl": "slatFlap",
        "target": "S+20°",
        "action": "Slat/Flap Handle — S+20°",
        "note": "T/O configuration"
      },
      {
        "ctrl": "yawDamp",
        "target": "ON",
        "action": "YAW DAMP — ON",
        "note": "Must be centered for T/O"
      },
      {
        "ctrl": "parkBrk",
        "target": "OFF",
        "action": "Parking Brake — OFF",
        "note": "Ready to taxi"
      },
      {
        "ctrl": "taxiLt",
        "target": "ON",
        "action": "TAXI LIGHT — ON"
      },
      {
        "ctrl": "xpdr",
        "target": "TA/RA",
        "action": "Transponder — TA/RA"
      }
    ]
  },
  {
    "id": "before_takeoff",
    "category": "Normal",
