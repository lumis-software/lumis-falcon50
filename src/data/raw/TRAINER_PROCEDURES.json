  {
    "id": "after_takeoff",
    "category": "Normal",
    "name": "After Takeoff / Climb",
    "desc": "Gear up at positive rate, slats/flaps retract on schedule, autopilot above 1,000 ft.",
    "steps": [
      {
        "ctrl": "slatFlap",
        "target": "SLATS",
        "action": "At V2+15: SLATS only"
      },
      {
        "ctrl": "slatFlap",
        "target": "CLEAN",
        "action": "At V2+25: CLEAN WING"
      },
      {
        "ctrl": "power1",
        "target": "CRUISE",
        "action": "Climb power — set"
      },
      {
        "ctrl": "power2",
        "target": "CRUISE",
        "action": "Climb power — set"
      },
      {
        "ctrl": "power3",
        "target": "CRUISE",
        "action": "Climb power — set"
      },
      {
        "ctrl": "ap",
        "target": "ON",
        "action": "Autopilot — ENGAGE (>1,000 ft)"
      },
      {
        "ctrl": "machTrim",
        "target": "ON",
        "action": "Mach Trim — ON (above 0.78 M)"
      }
    ]
  },
  {
    "id": "approach_landing",
    "category": "Normal",
    "name": "Approach & Landing",
    "desc": "Configure for landing. Slats → Flaps 20° → Gear → Flaps 48° on final.",
    "steps": [
      {
        "ctrl": "slatFlap",
        "target": "SLATS",
        "action": "Slats — EXTEND (≤200 KIAS)"
      },
      {
        "ctrl": "slatFlap",
        "target": "S+20°",
        "action": "Flaps 20° (≤190 KIAS)"
      },
      {
        "ctrl": "landingLt",
        "target": "ON",
        "action": "Landing lights — ON"
      },
      {
        "ctrl": "slatFlap",
        "target": "S+48°",
        "action": "Flaps 48° (≤175 KIAS, committed)"
      },
      {
        "ctrl": "ap",
        "target": "OFF",
        "action": "Autopilot — OFF (by min altitude)"
      },
      {
        "ctrl": "power1",
        "target": "IDLE",
        "action": "Touchdown — power levers IDLE"
      },
      {
        "ctrl": "power2",
        "target": "IDLE",
        "action": "Power 2 — IDLE"
      },
      {
        "ctrl": "power3",
        "target": "IDLE",
        "action": "Power 3 — IDLE"
      },
      {
        "ctrl": "reverser",
        "target": "DEPLOY",
        "action": "Thrust Reverser (ENG 2) — DEPLOY",
        "note": "Max 30 sec"
      }
    ]
  },
